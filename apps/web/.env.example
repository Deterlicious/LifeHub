# `development` enables the visibly labelled local-only developer session form.
# Use `supabase` for hosted Supabase email/password authentication.
NEXT_PUBLIC_AUTH_MODE=development
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080/api/v1

# Required only when NEXT_PUBLIC_AUTH_MODE=supabase. These values are public.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
