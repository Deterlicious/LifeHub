# Local Go API. Never reuse the example secret outside local development.
# Non-production HTTP_ADDR must resolve to loopback so the dev issuer cannot be
# exposed to another machine.
APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://lifehub:lifehub@localhost:55432/lifehub?sslmode=disable
WEB_ORIGIN=http://127.0.0.1:3000
DEV_AUTH_SECRET=replace-with-at-least-32-random-characters

# Required by the API when APP_ENV=production. Development uses only the
# explicitly local DEV_AUTH_SECRET issuer; that route is absent in production.
SUPABASE_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_AUDIENCE=authenticated

# Optional bounded worker mode for scheduled Cloud Run Jobs. Leave both unset
# for the normal continuous worker used in local development and paid hosting.
# WORKER_RUN_DURATION=45s
# WORKER_PERIODIC_JOBS=false

# Next.js browser-safe configuration.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080/api/v1
NEXT_PUBLIC_AUTH_MODE=development
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
